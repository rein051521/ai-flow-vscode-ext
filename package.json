{
  "name": "ai-flow",
  "displayName": "%aiFlow.displayName%",
  "description": "%aiFlow.description%",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiFlow.open",
    "onCommand:aiFlow.stepC",
    "onView:aiFlow.runHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiFlow.open",
        "title": "%aiFlow.commands.open.title%"
      },
      {
        "command": "aiFlow.stepC",
        "title": "%aiFlow.commands.stepC.title%"
      }
    ],
    "configuration": {
      "title": "%aiFlow.configuration.title%",
      "properties": {
        "aiFlow.pythonPath": {
          "type": "string",
          "default": ".\\\\.venv\\\\Scripts\\\\python",
          "description": "%aiFlow.configuration.aiFlow.pythonPath.description%"
        },
        "aiFlow.validateScript": {
          "type": "string",
          "default": "scripts\\\\validate_repo.py",
          "description": "%aiFlow.configuration.aiFlow.validateScript.description%"
        },
        "aiFlow.guardScript": {
          "type": "string",
          "default": "scripts\\\\guard_worktree.py",
          "description": "%aiFlow.configuration.aiFlow.guardScript.description%"
        },
        "aiFlow.strictClean": {
          "type": "boolean",
          "default": true,
          "description": "%aiFlow.configuration.aiFlow.strictClean.description%"
        },
        "aiFlow.pythonCommand": {
          "type": "string",
          "default": "py",
          "description": "%aiFlow.configuration.aiFlow.pythonCommand.description%"
        },
        "aiFlow.pythonArgs": {
          "type": "array",
          "default": [
            "-3.12"
          ],
          "items": {
            "type": "string"
          },
          "description": "%aiFlow.configuration.aiFlow.pythonArgs.description%"
        },
        "aiFlow.defaultMode": {
          "type": "string",
          "enum": [
            "docs",
            "full"
          ],
          "default": "full",
          "description": "%aiFlow.configuration.aiFlow.defaultMode.description%"
        },
        "aiFlow.gate.timeoutSec": {
          "type": "number",
          "default": 900,
          "minimum": 30,
          "description": "%aiFlow.configuration.aiFlow.gate.timeoutSec.description%"
        },
        "aiFlow.templates.canonicalCodegenJa": {
          "type": "string",
          "default": "docs/prompts/AI_FLOW_CODEGEN_JA.md",
          "description": "%aiFlow.configuration.aiFlow.templates.canonicalCodegenJa.description%"
        },
        "aiFlow.templates.canonicalDebugJa": {
          "type": "string",
          "default": "docs/prompts/AI_FLOW_DEBUG_JA.md",
          "description": "%aiFlow.configuration.aiFlow.templates.canonicalDebugJa.description%"
        },
        "aiFlow.templates.fallbackPolicy": {
          "type": "string",
          "default": "deny",
          "enum": [
            "prompt",
            "deny",
            "allow"
          ],
          "description": "%aiFlow.configuration.aiFlow.templates.fallbackPolicy.description%"
        },
        "aiFlow.docs.featureSpecTemplate": {
          "type": "string",
          "default": "docs/specs/FEATURE_SPEC_TEMPLATE.md",
          "description": "%aiFlow.configuration.aiFlow.docs.featureSpecTemplate.description%"
        },
        "aiFlow.docs.featureTasksTemplateJa": {
          "type": "string",
          "default": "docs/specs/FEATURE_TASKS_TEMPLATE_JA.yaml",
          "description": "%aiFlow.configuration.aiFlow.docs.featureTasksTemplateJa.description%"
        },
        "aiFlow.docs.outDir": {
          "type": "string",
          "default": "docs/specs",
          "description": "%aiFlow.configuration.aiFlow.docs.outDir.description%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiFlow.open",
          "when": "true"
        },
        {
          "command": "aiFlow.stepC",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiFlow",
          "title": "%aiFlow.viewsContainer.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aiFlow": [
        {
          "id": "aiFlow.runHistory",
          "name": "%aiFlow.views.runHistory.name%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm run compile",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc -p . --noEmit",
    "lint": "npm run typecheck",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --watch",
    "build": "npm run typecheck && npm run compile",
    "package:vsix": "npm run vscode:prepublish && vsce package --no-dependencies",
    "package:vsix:quiet": "node scripts/package_vsix_quiet.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.4",
    "esbuild": "^0.27.2",
    "@vscode/vsce": "^3.6.0"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "yaml": "^2.5.0"
  },
  "license": "MIT",
  "repository": "file:.",
  "homepage": "",
  "bugs": {
    "url": ""
  }
}
